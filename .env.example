# ==========================================
# SafarGuard Environment Configuration Example
# ==========================================

# Google Gemini / Gemma 4 API Key
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (gemini-2.5-flash, gemini-1.5-flash, gemma-4-31b)
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud API Key (Optional Fallback)
# Obtain free key at: https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here

# Application Configuration
APP_ENV=production
DEBUG=False
PORT=8501

# Motorway Authority / Alert Webhook (Optional)
NHMP_EMERGENCY_DISPATCH_WEBHOOK=https://api.example.com/nhmp/dispatch
RESCUE_1122_GATEWAY_URL=https://api.example.com/rescue1122/alert
